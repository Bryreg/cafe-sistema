# .env.prod NO se versiona — contiene SECRET_KEY de producción
backend/.env
backend/.env.prod
frontend/.env.local
frontend/.env.*.local

# ── Node / Frontend ──────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/

# ── Sistema operativo ────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

.vercel

# Índice local de CodeGraph (por checkout, no se comparte)
.codegraph/

# Cache de tooling (skill registry), no es del producto
.atl/

# Lienzo de Claude Design ya armado (2,5 MB, se regenera desde docs/diseno/)
.diseno-vida-insumo/
