# ── Python ──────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/

# ── Bases de datos (cada entorno tiene la suya) ──
*.db
*.sqlite3

# ── Uploads (binarios, no van en git) ────────────
backend/uploads/
backend/uploads_dev/
backend/uploads_sandbox/

# ── Variables de entorno (secretos) ─────────────
